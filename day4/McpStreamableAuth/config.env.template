# Copy this file to .env. `npm run start:sdk` loads it with node's built-in
# --env-file; in a container the platform (Azure App Service settings, docker
# run -e, ...) supplies the same variables.

# Your Scalekit environment URL. Get it from https://app.scalekit.com/ws/workspace/manage/environments
SCALEKIT_ENVIRONMENT_URL=https://<your-value>.scalekit.dev

# The OAuth 2.0 authorization server for this MCP server. Scalekit creates one
# per MCP server; the URL is shown in the dashboard under MCP Servers.
# `/.well-known/oauth-protected-resource/mcp` advertises it to clients.
SCALEKIT_AUTH_SERVER=https://<your-value>.scalekit.dev/resources/res_<your-value>

# Your Scalekit client credentials. Get it from https://app.scalekit.com/ws/environments/<your-env>/settings/api-credentials
SCALEKIT_CLIENT_ID=your-value
SCALEKIT_CLIENT_SECRET=your-value

# Your MCP server resource identifier (the "Resource identifier"/audience
# configured in Scalekit). Tokens must carry it in their `aud` claim.
# Only used when NODE_ENV=production; otherwise the server uses
# http://localhost:3000/mcp so local tokens match.
MCP_RESOURCE_ID=your-value

# Scopes this MCP server understands (space-separated)
MCP_SCOPES=ponypwd:generate
