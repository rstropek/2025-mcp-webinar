# OPTIONAL. The server runs without any configuration against the local
# Keycloak from ../../keycloak. Copy this file to .env only if you want to
# override a default; `npm run start:sdk` loads .env if it exists.

# The authorization server (OIDC issuer) that issues tokens for this server.
# Must match the `iss` claim of the tokens exactly.
OAUTH_ISSUER=http://localhost:8080/realms/mcp-webinar

# This server's resource identifier: advertised in the protected resource
# metadata and required in the `aud` claim of every token. Defaults to
# http://localhost:<PORT>/mcp.
MCP_RESOURCE_ID=http://localhost:3000/mcp

# Scopes this MCP server understands (space-separated)
MCP_SCOPES=ponypwd:generate

# Port to listen on (default 3000). If you change it, change MCP_RESOURCE_ID
# and the resource client in the Keycloak realm as well.
PORT=3000
