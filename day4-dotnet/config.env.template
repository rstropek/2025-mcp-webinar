# OPTIONAL configuration for the day 4 MCP server (OAuth 2.1).
#
# Out of the box the server uses the local Keycloak from ../keycloak, configured
# in appsettings.json. Set these only to override that.
#
# These are ASP.NET Core configuration keys expressed as environment variables:
# `__` (double underscore) is the section separator, so `OAuth__Issuer`
# overrides `"OAuth": { "Issuer": ... }` from appsettings.json.

# The authorization server (OIDC issuer). Used as the JWT bearer `Authority`
# (which triggers OIDC discovery for the signing keys), as the expected `iss`
# claim, and as `authorization_servers` in the RFC 9728 document at
# /.well-known/oauth-protected-resource/mcp.
OAuth__Issuer=http://localhost:8080/realms/mcp-webinar

# The URL the server listens on. It also defines the server's OAuth resource
# identifier (`<ASPNETCORE_URLS>/mcp`), which is both the `resource` field of
# the metadata document and the `aud` claim every token must carry. For local
# runs `Properties/launchSettings.json` already sets this to
# http://localhost:3000, which matches the resource client in the Keycloak realm.
ASPNETCORE_URLS=http://localhost:3000
