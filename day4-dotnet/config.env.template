# Configuration for the day 4 MCP server (OAuth 2.1).
#
# These are ASP.NET Core configuration keys expressed as environment variables:
# `__` (double underscore) is the section separator, so `Scalekit__Issuer`
# overrides `"Scalekit": { "Issuer": ... }` from appsettings.json.
#
# Locally you can simply keep the values in `appsettings.json` /
# `appsettings.Development.json` (the committed ones point at the demo tenant).
# Use environment variables when you deploy — Azure App Service application
# settings, `docker run -e ...`, a Kubernetes secret, and so on.

# The OIDC issuer of your Scalekit environment. Used as the JWT bearer
# `Authority` (which triggers OIDC discovery for the signing keys) and as the
# expected `iss` claim. Find it at
# https://app.scalekit.com/ws/workspace/manage/environments
Scalekit__Issuer=https://<your-env>.scalekit.dev

# The OAuth 2.0 authorization server for THIS MCP server. Scalekit creates one
# per MCP server; the URL is shown in the dashboard under "MCP Servers".
# It is published in `authorization_servers` of the RFC 9728 document at
# /.well-known/oauth-protected-resource/mcp.
Scalekit__EnvironmentUrl=https://<your-env>.scalekit.dev/resources/res_<your-value>

# The URL the server listens on. It also defines the server's OAuth resource
# identifier (`<ASPNETCORE_URLS>/mcp`), which is both the `resource` field of
# the metadata document and the `aud` claim every token must carry.
# For local runs `Properties/launchSettings.json` already sets this to
# http://localhost:3000.
ASPNETCORE_URLS=http://localhost:3000
