{
  "name": "mcp_mylittlepony",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "build": "tsc && cp -r src/data dist/",
    "start:no-sdk": "npx @modelcontextprotocol/inspector tsx ./src/server-no-sdk.ts",
    "start:sdk": "npx @modelcontextprotocol/inspector tsx ./src/server-sdk.ts",
    "start:client": "npm run build && node ./dist/client.js",
    "start:chat": "npm run build && node --env-file=.env dist/chat-client.js",
    "start:mastra-client": "npm run build && node --env-file=.env dist/mastra-client.js",
    "check": "biome check --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "biome ci ."
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@mastra/core": "^1.76.0",
    "@mastra/mcp": "^2.3.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "openai": "^7.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@mcpjam/inspector": "3.15.0",
    "@modelcontextprotocol/inspector": "^2.10.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@modelcontextprotocol/client": "$@modelcontextprotocol/client"
  }
}
